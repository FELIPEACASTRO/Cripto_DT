# =============================================================================
# Cripto DT - Variaveis de Ambiente
# Copie para .env e preencha com seus valores reais:
#   cp .env.example .env
# =============================================================================

# --- Chaves de API (obrigatorio para coleta de dados) -----------------------
CRYPTOCOMPARE_API_KEY=sua_chave_cryptocompare_aqui
ETHERSCAN_API_KEY=sua_chave_etherscan_aqui

# --- Servidor API (FastAPI) --------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Dashboard (Streamlit) ---------------------------------------------------
STREAMLIT_PORT=8501

# --- Diretorios (caminhos dentro do container) --------------------------------
MODEL_DIR=/app/models
DATA_DIR=/app/data
